<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- NORMAL / SETUP / HOST MENU -->
        <LinearLayout
            android:id="@+id/menuLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MeetingLock"
                android:textColor="#1A237E"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pixel 7a Prototype"
                android:textColor="#546E7A"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- Permission Status Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONE-TIME SETUP"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accessibility Lock: NOT ENABLED"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="1. Enable Accessibility Service" />

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Display Over Other Apps: NOT ENABLED"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnEnableOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="2. Allow Display Over Other Apps" />
            </LinearLayout>

            <!-- Attendee Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ATTENDEE MODE"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnScanLockQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#1565C0"
                    android:text="Scan Host Lock QR" />

                <Button
                    android:id="@+id/btnQuickTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00838F"
                    android:text="Quick 60-Second Self-Test" />
            </LinearLayout>

            <!-- Host Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOST MODE (MEETING HEAD)"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etDurationMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Meeting duration in minutes (e.g. 30)"
                    android:inputType="number"
                    android:text="5" />

                <Button
                    android:id="@+id/btnHostGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#2E7D32"
                    android:text="Generate Lock QR Code" />

                <Button
                    android:id="@+id/btnHostShowUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#EF6C00"
                    android:text="Show Unlock QR Code"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvQrLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="#263238"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:contentDescription="QR Code"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- LOCKED SCREEN VIEW -->
        <LinearLayout
            android:id="@+id/lockedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION LOCKED"
                android:textColor="#C62828"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Only Phone Calls and SMS Messages are permitted until unlocked."
                android:textColor="#455A64"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="28dp"
                android:text="00:00 remaining"
                android:textColor="#1A237E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#1565C0"
                android:text="Open Phone (Calls)"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnOpenSms"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#2E7D32"
                android:text="Open Messages (SMS)"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnScanUnlockQr"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#EF6C00"
                android:text="Scan Host Unlock QR"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
